{
  "_meta": {
    "description": "Canonical software / database registry for the metabolomics adapter family. Three sets: 'software' maps alias spellings to a canonical processing-software name; 'databases' lists names ASB's heuristic 'tools' list emits that are actually reference databases (not processing software) — these should be projected as `uses_database`, not `has_processing_software`; 'ignore' lists general-purpose language/runtime/repo-host names that should never enter a metabolomics claim. Used by `canonical_software_name()`, `is_metabolomics_tool()`, and `is_metabolomics_database()`. Added v0.5.0 per audit-2 finding 6a/6b/6c — ASB heuristics emit free-text tool names with no canonical form and mix software with databases and general-purpose languages.",
    "version": 1,
    "added_in": "0.5.0"
  },
