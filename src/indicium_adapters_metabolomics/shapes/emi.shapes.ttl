@prefix asb:  <https://w3id.org/asb#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Per-qualifier constraints on asb:Claim for EMI/METRIN-KG claims.
# Uses sh:sparql for conditional validation (fires only when qualifier matches).
# Requires advanced=True and sparql_mode=True in pyshacl.
#
# These fire on asb:domainQualifier (NOT the closed Bucur asb:qualifier enum):
# the EMI qualifiers below are open domain terms, so Perspicacité routes them to
# asb:domainQualifier (indicium#1 / indicium 1.7.0). Keying on asb:qualifier
# would silently never match emitted claims. (EMI's "interacts_with" is the one
# qualifier that IS a Bucur term and therefore rides asb:qualifier — no shape
# keys on it.)

asb:MediatesInteractionShape
    a sh:NodeShape ;
    sh:targetClass asb:Claim ;
    sh:sparql [
        sh:message "mediates_interaction claims should reference a Wikidata QID in subject or object" ;
        sh:severity sh:Warning ;
        sh:select """
            PREFIX asb: <https://w3id.org/asb#>
            SELECT $this
            WHERE {
                $this asb:domainQualifier "mediates_interaction" .
                FILTER NOT EXISTS {
                    { $this asb:subject_ontology_term ?s . FILTER(regex(str(?s), "^WD:Q[0-9]+$")) }
                    UNION
                    { $this asb:object_ontology_term ?o . FILTER(regex(str(?o), "^WD:Q[0-9]+$")) }
                }
            }
        """ ;
    ] .

asb:FoundInSpeciesShape
    a sh:NodeShape ;
    sh:targetClass asb:Claim ;
    sh:sparql [
        sh:message "found_in_species object_ontology_term should start with WD:Q or NCBITaxon:" ;
        sh:severity sh:Warning ;
        sh:select """
            PREFIX asb: <https://w3id.org/asb#>
            SELECT $this ?value
            WHERE {
                $this asb:domainQualifier "found_in_species" .
                $this asb:object_ontology_term ?value .
                FILTER (!regex(str(?value), "^(WD:Q|NCBITaxon:)"))
            }
        """ ;
    ] .

# AssociatedWithTraitShape: spec said "TRY trait identifier or QUDT unit", but TRY
# does not have a canonical CURIE prefix. PATO (phenotypic quality) and emi:Trait
# are accepted as functional substitutes; if a TRY: prefix is adopted in future,
# add it to the FILTER below.
asb:AssociatedWithTraitShape
    a sh:NodeShape ;
    sh:targetClass asb:Claim ;
    sh:sparql [
        sh:message "associated_with_trait object_ontology_term should reference a QUDT unit, PATO quality, or emi: trait" ;
        sh:severity sh:Warning ;
        sh:select """
            PREFIX asb: <https://w3id.org/asb#>
            SELECT $this ?value
            WHERE {
                $this asb:domainQualifier "associated_with_trait" .
                $this asb:object_ontology_term ?value .
                FILTER (!regex(str(?value), "^(qudtUnit|PATO|emi):"))
            }
        """ ;
    ] .
