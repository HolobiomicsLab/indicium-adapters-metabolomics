@prefix asb:  <https://w3id.org/asb#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# v0.4.0 — base required-fields shape. Every asb:Claim must carry an
# asb:subject AND at least one qualifier; severity is sh:Violation. This is the
# adapter family's BASE shape (lives on MetabolomicsAdapter) so when the
# three adapters are composed via compose_adapters() the constraint appears
# exactly once in the merged graph.
#
# v0.8.0 (indicium#1 / indicium 1.7.0) — qualifier-presence is now an either-or
# over the closed Bucur asb:qualifier enum and the open asb:domainQualifier slot.
# Perspicacité routes domain-adapter qualifiers (e.g. 'identifies') to
# asb:domainQualifier, so requiring asb:qualifier alone would reject every
# domain-only claim. Mirrors indicium's core QualifierPresenceShape.
asb:ClaimRequiredFieldsShape
    a sh:NodeShape ;
    sh:targetClass asb:Claim ;
    sh:property [
        sh:path asb:subject ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "asb:Claim must have at least one asb:subject" ;
    ] ;
    sh:or (
        [ sh:path asb:qualifier ; sh:minCount 1 ]
        [ sh:path asb:domainQualifier ; sh:minCount 1 ]
    ) ;
    sh:message "asb:Claim must carry at least one of asb:qualifier (closed Bucur SuperPattern) or asb:domainQualifier (open domain-adapter extension)." .

# v0.4.0 — bumped from sh:Warning to sh:Violation per audit finding #4.
# CURIE format on subject/object ontology terms is checked only when those
# slots are present (sh:minCount is unset → 0..*). An unrecognised metabolomics
# prefix is now a hard failure rather than a tolerated warning, so consumers
# get a deterministic signal when an extractor emits a bogus CURIE.
asb:MetabolomicsClaimCurieShape
    a sh:NodeShape ;
    sh:targetClass asb:Claim ;
    sh:property [
        sh:path asb:subject_ontology_term ;
        sh:pattern "^(CHEBI|HMDB|MTBLS|MW|MSV|KEGG|LIPIDMAPS|PUBCHEM|WD|REFMET|NCBITaxon|ENVO):[A-Za-z0-9_.:-]+$" ;
        sh:severity sh:Violation ;
        sh:message "subject_ontology_term must use a recognized metabolomics prefix (CHEBI/HMDB/MTBLS/MW/MSV/KEGG/LIPIDMAPS/PUBCHEM/WD/REFMET/NCBITaxon/ENVO)" ;
    ] ;
    sh:property [
        sh:path asb:object_ontology_term ;
        sh:pattern "^(CHEBI|HMDB|MTBLS|MW|MSV|KEGG|LIPIDMAPS|PUBCHEM|WD|REFMET|NCBITaxon|ENVO):[A-Za-z0-9_.:-]+$" ;
        sh:severity sh:Violation ;
        sh:message "object_ontology_term must use a recognized metabolomics prefix (CHEBI/HMDB/MTBLS/MW/MSV/KEGG/LIPIDMAPS/PUBCHEM/WD/REFMET/NCBITaxon/ENVO)" ;
    ] .
