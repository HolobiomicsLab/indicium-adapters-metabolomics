@prefix asb:  <https://asb.holobiomics.org/ns/asb#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Validate CURIE format on subject/object ontology terms in any asb:Claim.
# Warning-level: foreign CURIEs are tolerated but flagged.
asb:MetabolomicsClaimCurieShape
    a sh:NodeShape ;
    sh:targetClass asb:Claim ;
    sh:property [
        sh:path asb:subject_ontology_term ;
        sh:pattern "^(CHEBI|HMDB|MTBLS|KEGG|LIPIDMAPS|PUBCHEM|WD|REFMET|NCBITaxon|ENVO):[A-Za-z0-9_.:-]+$" ;
        sh:severity sh:Warning ;
        sh:message "subject_ontology_term should use a recognized metabolomics prefix" ;
    ] ;
    sh:property [
        sh:path asb:object_ontology_term ;
        sh:pattern "^(CHEBI|HMDB|MTBLS|KEGG|LIPIDMAPS|PUBCHEM|WD|REFMET|NCBITaxon|ENVO):[A-Za-z0-9_.:-]+$" ;
        sh:severity sh:Warning ;
        sh:message "object_ontology_term should use a recognized metabolomics prefix" ;
    ] .
